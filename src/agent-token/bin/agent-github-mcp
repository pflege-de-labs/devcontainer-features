#!/usr/bin/env bash
# Starts the local github-mcp-server with an agent token for the repo in the current directory.
# The token is fixed for the process lifetime (1h): reconnect via /mcp after it expires.
set -euo pipefail
repo=$(git remote get-url origin)
repo=${repo%.git}
repo=${repo#*github.com[:/]}
GITHUB_PERSONAL_ACCESS_TOKEN=$(AGENT_TOKEN_NONINTERACTIVE=1 agent-token "$repo")
export GITHUB_PERSONAL_ACCESS_TOKEN
exec github-mcp-server stdio "$@"
